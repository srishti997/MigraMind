# Local default; contains no credentials.
DATABASE_URL=sqlite:///./migramind.db
# For PostgreSQL, configure DATABASE_URL in your ignored .env with local credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development allows HTTP on loopback. Invalid APP_ENV values fail startup.
# production requires explicit HTTPS CORS_ORIGINS, ALLOWED_HOSTS and PostgreSQL
# DATABASE_URL with sslmode=verify-full; no SQLite/default production fallback.
# Production uses Secure __Host- cookies and rejects non-HTTPS ASGI requests.
APP_ENV=development
DATA_MODE=local
# Hosted demos require DATA_MODE=synthetic and this exact acknowledgement:
# DEMO_ACKNOWLEDGEMENT=synthetic-only-no-real-health-data
# Use deploy/demo.env.example; never point a demo at personal/research records.
# Hostnames only, no scheme, ports or wildcard. Override explicitly for production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Absolute authenticated session lifetime (1–168 hours); anonymous CSRF session: 1 hour.
SESSION_HOURS=12
# No signing secret is needed: opaque random session IDs are hashed in the database.
# Never put passwords or database credentials in this template or VITE_ variables.
