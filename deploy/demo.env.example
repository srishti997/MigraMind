# TEMPLATE ONLY. Empty/invalid settings deliberately prevent startup.
APP_ENV=production
DATA_MODE=synthetic
DEMO_ACKNOWLEDGEMENT=synthetic-only-no-real-health-data
DATABASE_URL=
# Dedicated PostgreSQL database name must end _synthetic_demo.
# Configure sslmode=verify-full and the approved CA; store credentials outside Git.
CORS_ORIGINS=https://demo.invalid
ALLOWED_HOSTS=demo.invalid
SESSION_HOURS=1
PORT=8015
# Set DEMO_PASSWORD only during explicit provisioning, then remove it.
# Runtime needs the database connection secret, not the plaintext demo password.
