# Include in the nginx http context. Template requires operator-owned DNS/TLS paths.
# Do not enable before nginx -t and isolated staging smoke tests.
limit_req_zone $binary_remote_addr zone=migramind_demo:10m rate=5r/s;
server {
    listen 80;
    server_name demo.invalid;
    access_log off;
    return 400;
}
server {
    listen 443 ssl;
    server_name demo.invalid;
    ssl_certificate /etc/migramind/tls/fullchain.pem;
    ssl_certificate_key /etc/migramind/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/migramind/current/frontend/dist;
    access_log off;
    error_log /var/log/nginx/migramind-demo-error.log crit;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control no-store always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" always;
    location /api/ {
        limit_req zone=migramind_demo burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8015;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
