[Unit]
Description=MigraMind read-only synthetic demonstration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=migramind-demo
Group=migramind-demo
WorkingDirectory=/opt/migramind/current/backend
EnvironmentFile=/etc/migramind/demo.env
ExecStartPre=/opt/migramind/current/backend/.venv/bin/python -m app.serve --check
ExecStart=/opt/migramind/current/backend/.venv/bin/python -m app.serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/migramind-demo
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
